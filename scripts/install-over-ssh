#!/usr/bin/env bash
# Install sixos on the target laptop, from the build machine, over ssh.
#
# The laptop only has to be booted into the NixOS live USB with a root
# password set (README.md, step 4).  Nothing big is stored on the live USB:
#
#   1. builds the system and the installer here (if not built yet)
#   2. copies the installer (~300 MB) into the live USB's Nix store
#   3. runs `sixos-install --phase prepare` on the laptop: asks for the
#      passwords, erases and partitions the disk, mounts it at /mnt
#   4. copies the system straight into the laptop's new /mnt/nix/store.  The
#      laptop downloads everything that's on cache.nixos.org (kernel, firmware,
#      mesa...) itself; only what was built here crosses your network.
#   5. copies this repository to /home/USER/sixos-laptop (without result links)
#   6. runs `sixos-install --phase finish`: boot profiles, GRUB, unmount
#
# The automated test (tests/default.nix) runs this script too.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install-over-ssh LAPTOP_IP --disk DEV --user NAME [options]

  LAPTOP_IP         the live USB's address (`ip -br addr` on the laptop);
                    logs in as root (or give user@address)
  --disk DEV        the laptop's disk to ERASE, e.g. /dev/nvme0n1
  --user NAME       the `username` in site/hosts/laptop.nix

Options:
  --wifi SSID       Wi-Fi network for the installed system (asks for the
                    passphrase)
  --ssh-key FILE    public key allowed to log in as root on the installed
                    system, for pushing updates (README.md step 6), e.g.
                    ~/.ssh/id_ed25519.pub
  --uid N           the user's uid, if you changed it (default 1000)
  --no-substitute   copy everything from this machine instead of letting the
                    laptop download from cache.nixos.org (for a laptop without
                    internet access)
  --compress        compress the ssh connection (helps on slow Wi-Fi)
  --no-copy-repo    don't copy this repository to the laptop
  --no-nvram, --yes passed on to sixos-install (see sixos-install --help)
  --system PATH, --installer PATH
                    use these store paths instead of building them
EOF
}

die() { echo "install-over-ssh: $*" >&2; exit 1; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

TARGET='' DISK='' USERNAME='' WIFI='' SSH_KEY_FILE='' USER_UID=1000
SYSTEM='' INSTALLER='' SUBSTITUTE=1 COMPRESS='' COPY_REPO=1
PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --disk) DISK=$2; shift 2 ;;
    --user) USERNAME=$2; shift 2 ;;
    --wifi) WIFI=$2; shift 2 ;;
    --ssh-key) SSH_KEY_FILE=$2; shift 2 ;;
    --uid) USER_UID=$2; shift 2 ;;
    --no-substitute) SUBSTITUTE=''; shift ;;
    --compress) COMPRESS=1; shift ;;
    --no-copy-repo) COPY_REPO=''; shift ;;
    --no-nvram|--yes) PASS+=("$1"); shift ;;
    --system) SYSTEM=$2; shift 2 ;;
    --installer) INSTALLER=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; die "unknown option: $1" ;;
    *) [ -z "$TARGET" ] || die "more than one laptop address given"; TARGET=$1; shift ;;
  esac
done
[ -n "$TARGET" ] && [ -n "$DISK" ] && [ -n "$USERNAME" ] || { usage >&2; exit 1; }
case "$TARGET" in *@*) ;; *) TARGET=root@$TARGET ;; esac
if [ -n "$SSH_KEY_FILE" ]; then
  [ -f "$SSH_KEY_FILE" ] || die "--ssh-key: $SSH_KEY_FILE does not exist (create one with ssh-keygen)"
  PASS+=(--ssh-key "$(cat "$SSH_KEY_FILE")")
fi
[ -z "$WIFI" ] || PASS+=(--wifi "$WIFI")

# ---------------------------------------------------------------------------
step "Building the system and the installer"
# ---------------------------------------------------------------------------
if [ -z "$SYSTEM" ]; then
  nix-build "$ROOT" -A hosts.laptop.configuration -o "$ROOT/result"
  SYSTEM=$(readlink -f "$ROOT/result")
fi
if [ -z "$INSTALLER" ]; then
  nix-build "$ROOT" -A installer -o "$ROOT/result-installer"
  INSTALLER=$(readlink -f "$ROOT/result-installer")
fi
echo "system:    $SYSTEM"
echo "installer: $INSTALLER"

# ---------------------------------------------------------------------------
step "Connecting to $TARGET"
# ---------------------------------------------------------------------------
# One ssh connection, shared by everything below (and by Nix, through
# NIX_SSHOPTS), so the password is asked only once.  The live USB makes new
# host keys at every boot, so they are kept in a throwaway known_hosts file
# instead of yours.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/sixos-install.XXXXXX")
SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=$TMP/ssh" -o ControlPersist=yes
          -o "UserKnownHostsFile=$TMP/known_hosts")
[ -z "$COMPRESS" ] || SSH_OPTS+=(-C)
export NIX_SSHOPTS="${SSH_OPTS[*]}"
cleanup() {
  ssh "${SSH_OPTS[@]}" -O exit "$TARGET" 2>/dev/null || true
  rm -rf "$TMP"
}
trap cleanup EXIT

# run a command on the laptop (arguments are quoted for its shell, so
# expanding them here is intended)
# shellcheck disable=SC2029
remote() { ssh "${SSH_OPTS[@]}" "$TARGET" "$(printf '%q ' "$@")"; }
# ... with a terminal, for the questions sixos-install asks
# shellcheck disable=SC2029
remote_tty() { ssh "${SSH_OPTS[@]}" -t "$TARGET" "$(printf '%q ' "$@")"; }

echo "(If asked: accept the host key, then type the root password you set on the live USB.)"
[ "$(remote id -u)" = 0 ] || die "log in as root, e.g. root@ADDRESS (set its password with \`sudo passwd root\` on the live USB)"
remote nix-store --version >/dev/null || die "no nix-store on $TARGET: boot the NixOS live USB"

# ---------------------------------------------------------------------------
step "Copying the installer to the live USB"
# ---------------------------------------------------------------------------
nix-copy-closure --to "$TARGET" ${SUBSTITUTE:+--use-substitutes} "$INSTALLER"

# ---------------------------------------------------------------------------
step "Preparing $DISK on the laptop"
# ---------------------------------------------------------------------------
ENV=(env)
# for unattended installs (the automated test); see sixos-install --help
[ -z "${SIXOS_ROOT_PASSWORD_HASH:-}" ] || ENV+=("SIXOS_ROOT_PASSWORD_HASH=$SIXOS_ROOT_PASSWORD_HASH")
[ -z "${SIXOS_USER_PASSWORD_HASH:-}" ] || ENV+=("SIXOS_USER_PASSWORD_HASH=$SIXOS_USER_PASSWORD_HASH")
remote_tty "${ENV[@]}" "$INSTALLER/bin/sixos-install" --phase prepare \
  --disk "$DISK" --user "$USERNAME" --uid "$USER_UID" "${PASS[@]}"

# ---------------------------------------------------------------------------
step "Copying the system to the laptop's disk"
# ---------------------------------------------------------------------------
if [ -n "$SUBSTITUTE" ]; then
  echo "(The laptop downloads what it can from cache.nixos.org itself.)"
fi
nix --extra-experimental-features nix-command copy --no-check-sigs \
  ${SUBSTITUTE:+--substitute-on-destination} \
  --to "ssh://$TARGET?remote-store=/mnt" "$SYSTEM"

if [ -n "$COPY_REPO" ]; then
  # -------------------------------------------------------------------------
  step "Copying this repository to /home/$USERNAME/sixos-laptop"
  # -------------------------------------------------------------------------
  # tar stores the result* links as links; they are left out anyway, since
  # they would point at paths that don't exist on the laptop.
  DEST=/mnt/home/$USERNAME/sixos-laptop
  tar -C "$ROOT" --exclude='./result*' -cf - . \
    | remote sh -c "mkdir -p '$DEST' && tar -xf - -C '$DEST' --no-same-owner && chown -R $USER_UID:$USER_UID '$DEST'"
fi

# ---------------------------------------------------------------------------
step "Installing GRUB and finishing"
# ---------------------------------------------------------------------------
remote "$INSTALLER/bin/sixos-install" --phase finish \
  --disk "$DISK" --system "$SYSTEM" --user "$USERNAME" --uid "$USER_UID" "${PASS[@]}"

step "Done"
echo "Reboot the laptop (type \`reboot\` on it) and remove the USB stick."
